print "LINE {YDivisions-Y} COLUMN {X}"; set n 0; set Rp "{R}"; set Gp "{G}"; set Bp "{B}"; sensor blockSize Rp @size; set xmin {X*blockWidth}; set ymin {(YDivisions-Y)*blockHeight}; op add xmax xmin {blockWidth}; op add ymax ymin {blockHeight}; set x xmin; set y ymax; read R Rp n; read G Gp n; read B Bp n; op add n n 1; op add R R -32; op add G G -32; op add B B -32; op mul R R 2.7234; op mul G G 2.7234; op mul B B 2.7234; draw color R G B 255 0 0; draw rect x y -1 1 0 0; op add x x 1; jump 12 lessThan x xmax; drawflush display1; set x xmin; op sub y y 1; select y equal y ymin ymax y; jump 12 lessThan n blockSize
