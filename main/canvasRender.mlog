print "LINE {Y} COLUMN {X}"; set n 0; set VAR "{text}"; sensor blockSize VAR @size; set xmin {X*blockWidth}; set ymin {Y*blockHeight}; op add xmax xmin {blockWidth}; op add ymax ymin {blockHeight}; set x xmin; set y ymax; read R VAR n; op add n n 1; read G VAR n; op add n n 1; read B VAR n; op add n n 1; op add R R -32; op add G G -32; op add B B -32; op mul R R 2.72340425532; op mul G G 2.72340425532; op mul B B 2.72340425532; draw color R G B 255 0 0; draw rect x y -1 1 0 0; op add x x 1; jump 11 lessThan x xmax; drawflush display1; set x xmin; op sub y y 1; jump 11 greaterThanEq y ymax
